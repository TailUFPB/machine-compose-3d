# Copie para .env. Sem nada preenchido, tudo roda offline com o seed fictício.

# --- LLM: none (padrão, determinístico) | anthropic | openai (qualquer API compatível) ---
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
# só para LLM_PROVIDER=openai (ex.: https://api.featherless.ai/v1, http://localhost:11434/v1)
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60

# --- Agente selecionador ---
AGENTE_MAX_TENTATIVAS=4

# --- Pesquisa de preço ---
BUSCA_PROVIDER=seed
PRECO_CACHE_DIAS=7
LOJAS=Kabum,Pichau,Terabyte,Mercado Livre,Amazon

# --- Revisão ---
# true: achado bloqueante aberto impede a exportação, salvo override confirmado pelo usuário
BLOQUEANTE_BLOQUEIA_EXPORTACAO=true
# potência da fonte >= consumo estimado x margem
MARGEM_FONTE=1.3

# --- Supabase (opcional: espelha builds, itens, achados e ofertas) ---
SUPABASE_URL=
# backend usa a service_role; nunca exponha no front
SUPABASE_KEY=

# --- Langfuse (opcional: um trace por build, cada agente como span) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

CORS_ORIGINS=http://localhost:3000

# --- Front (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
